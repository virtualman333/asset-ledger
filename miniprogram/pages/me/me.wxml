<view class="page">
    <view class="hero">
        <text class="hero-label">ASSET LEDGER</text>
        <text class="hero-title">{{username || '股息账本'}}</text>
        <text class="hero-desc">多市场资产 · 股息视角 · v{{version}}</text>
    </view>

    <view class="menu-group" wx:for="{{menuGroups}}" wx:for-item="group" wx:key="title">
        <view class="menu-title">{{group.title}}</view>
        <view class="menu-card">
            <view class="menu-item" wx:for="{{group.items}}" wx:key="key" data-path="{{item.path}}" bindtap="handleMenuTap">
                <text>{{item.text}}</text><text class="menu-arrow">›</text>
            </view>
        </view>
    </view>

    <view class="card">
        <view class="row-between" bindtap="toggleBase">
            <text class="medium">后端地址</text><text class="small muted">{{apiBase}} ›</text>
        </view>
        <block wx:if="{{showBase}}">
            <label class="label">必须 HTTPS，且已在微信公众平台配置为 request 合法域名</label>
            <input class="input" value="{{apiBase}}" bindinput="onBaseInput" />
            <view class="form-actions"><button class="btn btn-ghost btn-block" bindtap="saveBase">保存</button></view>
        </block>
    </view>

    <view class="card">
        <view class="card-title">设计红线</view>
        <text class="small muted">AI 只生成草稿，人确认才入账；流水是唯一事实源；原始凭证永不硬删。</text>
    </view>

    <button class="btn btn-danger btn-block" bindtap="logout">退出登录</button>
</view>
