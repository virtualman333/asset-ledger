DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=1

DB_NAME=asset_ledger
DB_USER=ledger
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

BASE_CURRENCY=CNY
QUOTE_CACHE_SECONDS=60

# 进程内定时抓行情的间隔（分钟），0 = 关掉，改用 cron / 宝塔计划任务跑
# `python manage.py refresh_quotes`。README 让你把它写进 .env，模板里得有这一行。
# 多 worker 部署（gunicorn -w 4）时只有抢到锁的那个 worker 会真的抓，锁文件默认在
# server/var/quote_refresh.lock，要改位置就设 QUOTE_REFRESH_LOCK=<本机绝对路径>。
QUOTE_REFRESH_MINUTES=15

# Agent 抽取（可选，留空走规则兜底）
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_VISION_MODEL=gpt-4o-mini
LLM_TEXT_MODEL=gpt-4o-mini
